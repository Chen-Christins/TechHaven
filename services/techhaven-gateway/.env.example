# ===== TechHaven Agent Gateway（TH-RFC-001 §05.1）=====

# Bearer 令牌：除 /healthz 外所有 API 都要求 `Authorization: Bearer <该值>`（必填，缺失拒绝启动）
TECHHAVEN_GATEWAY_TOKEN=

# HTTP 监听端口（默认 3091）
TECHHAVEN_GATEWAY_PORT=3091

# 引擎驱动：mock=脚本化闭环（演示/测试用）；dsh=真实 DeepSeek Harness 引擎（驱动文件另行交付，未就绪时启动即退出）
TECHHAVEN_ENGINE_DRIVER=mock

# 会话事件 / 审计 JSONL 目录（postgres 模式下是提交后 spool；文件名固定 gateway.jsonl）
TECHHAVEN_GATEWAY_DATA_DIR=./data

# 权威存储：jsonl（默认，单实例 PoC）| postgres（PG 权威，JSONL 只作 spool）
TECHHAVEN_GATEWAY_STORE=jsonl

# store=postgres 时必填；连接或事务失败会 fail-closed，不回退为 JSONL 权威
TECHHAVEN_GATEWAY_DB_URL=
TECHHAVEN_GATEWAY_DB_SCHEMA=public

# 单组织活动会话数配额（queued / running / awaiting_permission 计入；正整数）
TECHHAVEN_MAX_SESSIONS_PER_ORG=3

# ===== 迁移/装载兼容变量 =====
# PostgreSQL 连接串：`npm run load` 把 gateway.jsonl 装载进 agent_identities / agent_sessions /
# agent_events 时使用（也可用 --url 参数传入，优先级更高）
# 示例：postgres://postgres:postgres@127.0.0.1:5432/techhaven
TECHHAVEN_DB_URL=

# ===== dsh 驱动 =====
# dsh 可执行文件路径（TECHHAVEN_DSH_BIN）
TECHHAVEN_DSH_BIN=
# dsh 引擎 profile 名（由 Gateway 统一下发，前端不可指定）
TECHHAVEN_DSH_PROFILE=
# dsh 主目录（引擎工作区 / 缓存根）
TECHHAVEN_DSH_HOME=
