# 开发环境配置
VITE_API_BASE_URL=https://techhaven.website:8080
VITE_WS_URL=wss://techhaven.website:8080
VITE_USE_PROXY=true
VITE_REQUIRE_CREDENTIALS=false

# 本机 Agent Gateway（R1 接线，仅开发用非机密占位值）：
# 启动网关时 TECHHAVEN_GATEWAY_TOKEN 需与此值一致，见 services/techhaven-gateway/README.md
VITE_GATEWAY_URL=http://127.0.0.1:3091
VITE_GATEWAY_TOKEN=dev-token
